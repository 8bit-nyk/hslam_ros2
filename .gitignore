HSLAM/Thirdparty/CompiledLibs/
# build.sh downloads and extracts ceres here; it is a build artifact like CompiledLibs and
# onnxruntime below, not source. Left untracked it makes the eval-server tree permanently
# 'dirty', which stamps every summary.csv row dirty=1 and makes it unusable in a paper table.
HSLAM/Thirdparty/ceres-solver-*/
HSLAM/Thirdparty/ceres-solver-*.tar.gz
HSLAM/build/
# Any secondary local build tree (e.g. HSLAM/build_wp3c/, created 2026-09-19 because the primary
# build cache pointed at compiler wrappers that no longer exist) and its logs are per-machine artefacts.
HSLAM/build_*/
HSLAM/build_*.log
# HSLAM/run_scripts/
HSLAM/results/
# RA-L v2 eval output (summary.csv, per-rep run.log and result.txt). Data, not source --
# and leaving it untracked would keep the eval tree dirty, stamping every subsequent row
# dirty=1 and making it unusable in a paper table.
HSLAM/runs/
HSLAM/models/
HSLAM/logs
HSLAM/mats
HSLAM/images_out
HSLAM/docs
HSLAM/tests/
HSLAM/scripts/
